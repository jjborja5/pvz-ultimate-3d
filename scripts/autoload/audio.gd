extends Node
## Audio manager: music with crossfades on a Music bus, pooled one-shot SFX on an SFX bus.
## All audio files are original, generated by tools/synth_audio.py.
## SFX use per-sound cooldowns and a voice limit so large battles never flood the mixer.

const MUSIC_DIR := "res://assets/audio/music/"
const SFX_DIR := "res://assets/audio/sfx/"
const VOICES := 20
const LOOPING := ["menu", "battle", "boss"]

## Default minimum seconds between two plays of the same sound.
const COOLDOWNS := {
	"arrow_shoot": 0.07, "arrow_hit": 0.06, "enemy_hit": 0.05, "enemy_death": 0.06, "skeleton_death": 0.06,
	"explosion": 0.09, "chain_zap": 0.08, "fire_whoosh": 0.12, "ice_cast": 0.15, "ice_shatter": 0.1,
	"coin": 0.07, "castle_hit": 0.25, "cannon_fire": 0.08, "sword_slash": 0.1, "magic_cast": 0.1,
}

var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _music_current := ""
var _pool: Array[AudioStreamPlayer] = []
var _streams := {}
var _last := {}
var _fade: Tween
var plays := 0     # total sfx played (diagnostics / tests)


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_ensure_bus("Music")
	_ensure_bus("SFX")
	_music_a = _player("Music")
	_music_b = _player("Music")
	for i in VOICES:
		_pool.append(_player("SFX"))
	apply_volumes()
	GameState.settings_changed.connect(apply_volumes)


func _ensure_bus(name: String) -> void:
	if AudioServer.get_bus_index(name) == -1:
		AudioServer.add_bus()
		var i := AudioServer.bus_count - 1
		AudioServer.set_bus_name(i, name)
		AudioServer.set_bus_send(i, "Master")


func _player(bus: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = bus
	add_child(p)
	return p


func apply_volumes() -> void:
	var mv := clampf(float(GameState.settings.get("music_volume", 0.6)), 0.0, 1.0)
	var sv := clampf(float(GameState.settings.get("sfx_volume", 0.8)), 0.0, 1.0)
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Music"), linear_to_db(maxf(mv, 0.0001)))
	AudioServer.set_bus_mute(AudioServer.get_bus_index("Music"), mv <= 0.001)
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("SFX"), linear_to_db(maxf(sv, 0.0001)))
	AudioServer.set_bus_mute(AudioServer.get_bus_index("SFX"), sv <= 0.001)


func _stream(path: String) -> AudioStream:
	if _streams.has(path):
		return _streams[path]
	var s: AudioStream = load(path) if ResourceLoader.exists(path) else null
	_streams[path] = s
	return s


# ------------------------------------------------------------------ music

func play_music(name: String, fade := 1.2) -> void:
	if name == _music_current:
		return
	var s := _stream(MUSIC_DIR + name + ".ogg")
	if s == null:
		return
	if s is AudioStreamOggVorbis:
		(s as AudioStreamOggVorbis).loop = LOOPING.has(name)
	_music_current = name
	var incoming := _music_b if _music_a.playing else _music_a
	var outgoing := _music_a if incoming == _music_b else _music_b
	incoming.stream = s
	incoming.volume_db = -40.0
	incoming.play()
	if _fade:
		_fade.kill()
	_fade = create_tween().set_parallel(true)
	_fade.tween_property(incoming, "volume_db", 0.0, fade)
	if outgoing.playing:
		_fade.tween_property(outgoing, "volume_db", -40.0, fade)
		_fade.chain().tween_callback(outgoing.stop)


func current_music() -> String:
	return _music_current


func stop_music(fade := 1.0) -> void:
	_music_current = ""
	for p in [_music_a, _music_b]:
		if p.playing:
			var tw := create_tween()
			tw.tween_property(p, "volume_db", -40.0, fade)
			tw.tween_callback(p.stop)


# ------------------------------------------------------------------ sfx

func sfx(name: String, volume_db := 0.0, pitch_var := 0.06, cooldown := -1.0) -> void:
	var now := Time.get_ticks_msec() / 1000.0
	var cd: float = cooldown if cooldown >= 0.0 else float(COOLDOWNS.get(name, 0.03))
	if now - float(_last.get(name, -10.0)) < cd:
		return
	var s := _stream(SFX_DIR + name + ".ogg")
	if s == null:
		return
	_last[name] = now
	var p: AudioStreamPlayer = null
	for candidate in _pool:
		if not candidate.playing:
			p = candidate
			break
	if p == null:
		# steal the voice that has played the longest
		p = _pool[0]
		var best := -1.0
		for candidate in _pool:
			var pos := candidate.get_playback_position()
			if pos > best:
				best = pos
				p = candidate
	p.stream = s
	p.volume_db = volume_db
	p.pitch_scale = 1.0 + randf_range(-pitch_var, pitch_var)
	p.play()
	plays += 1
